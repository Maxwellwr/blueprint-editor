{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.2",
  "diagnostics.globals": [
    "data",
    "defines",
    "game",
    "script",
    "storage",
    "settings",
    "remote",
    "rcon",
    "rendering",
    "commands",
    "mods",
    "log",
    "helpers",
    "localised_print",
    "serpent",
    "table_size",
    "describe",
    "it",
    "before_each",
    "after_each",
    "setup",
    "teardown",
    "context",
    "pending",
    "finally",
    "assert",
    "spy",
    "mock",
    "stub",
    "randomize",
    "lazy_setup",
    "lazy_teardown",
    "strict_setup",
    "strict_teardown"
  ],
  "diagnostics.disable": [
    "undefined-field"
  ]
}
